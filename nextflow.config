// Neuro V1/V2 spatial-CCC pipeline — Nextflow DSL2 config.
// Run: nextflow run . -entry GW20_2X2 -profile standard --gw20_input <h5ad> ...
//      nextflow run . -entry GW34_PERSISTENCE -profile slurm ...
//      nextflow run . -entry GW20_2X2 -profile test -stub   (DAG smoke, no compute)

manifest {
    name            = 'neuro-v1v2-ccc'
    description      = 'Spatial cell-cell communication at the V1/V2 boundary (GW20 2x2 + GW34 persistence)'
    mainScript       = 'main.nf'
    nextflowVersion  = '>=23.10.0'
}

params {
    // entry selector (also selectable via -entry)
    entry                = 'gw20'

    // ---- inputs (override on the CLI; no hardcoded /scratch defaults) ----
    gw20_input           = "${projectDir}/data/FB080_O1b_v1v2_envi_input.h5ad"
    gw34_raw             = "${projectDir}/data/gw34_umb5900_ba17.h5ad"
    snrna_ref            = "${projectDir}/data/snrna.h5ad"
    outdir               = "${projectDir}/results"

    // GW20 cross-timepoint inputs for the persistence comparison
    gw20_commot_dir      = "${projectDir}/results/commot"
    gw20_signaling       = "${projectDir}/results/signaling_diff/signaling_diff_cpmz.csv"
    gw20_niche_dir       = "${projectDir}/results/niche_gw20_stagate_K8_h1"
    gw34_h1_placeholder  = "${projectDir}/assets/EMPTY"   // annotation parquet is wired via HARMONIZE_H1 in real runs

    // ---- pipeline params ----
    regions              = 'v1,v2'
    methods              = 'banksy,stagate'
    annotations          = 'scvi,scgpt'
    layers               = 'mz,l2,l3,l4,l5,l6,sp'   // GW34 override: 'cp,mz'
    k                    = 8
    kmin                 = 6
    kmax                 = 14
    n_perm               = 1000
    dis_thr              = 150.0
    cot_nitermax         = 500
    areas                = 'A-V1,B-V2'

    // ENVI / annotation
    envi_training_steps  = 10000
    envi_num_hvg         = 2048
    envi_celltype_key    = 'H2_annotation'
    lr_database          = 'cellchat'
    ref_label_key        = 'celltypes'
    leiden_resolution    = 1.0
    tag_name             = 'FB080'
    scgpt_model_dir      = "${projectDir}/models/scGPT_human"

    // container registry + tag (ECR/DockerHub); images: neuro-{envi,scvi,scgpt,stagate,analysis}
    registry             = 'neuro'
    tag                  = 'latest'

    // aws batch (awsbatch profile)
    queue                = 'neuro-batch-queue'
    aws_region           = 'us-east-1'
    s3_workdir           = 's3://CHANGE-ME-bucket/neuro/work'
}

// default (local) resources by label
process {
    withLabel: gpu       { cpus = 8;  memory = 128.GB }
    withLabel: cpu_large { cpus = 8;  memory = 60.GB }
    withLabel: cpu_small { cpus = 2;  memory = 16.GB }
}

profiles {
    standard {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    slurm {
        process.executor = 'slurm'
        singularity.enabled = true
        singularity.autoMounts = true
        process {
            withLabel: gpu       { queue = 'gpu';   cpus = 8; memory = 128.GB; time = '4h';  clusterOptions = '--gres=gpu:1' }
            withLabel: cpu_large { queue = 'short'; cpus = 8; memory = 60.GB;  time = '2d' }
            withLabel: cpu_small { queue = 'short'; cpus = 2; memory = 16.GB;  time = '1h' }
        }
    }

    awsbatch {
        process.executor = 'awsbatch'
        process.queue    = params.queue
        aws.region       = params.aws_region
        workDir          = params.s3_workdir
        docker.enabled   = true
        // per-label containers resolve from ${params.registry} (point at your ECR),
        // e.g. <acct>.dkr.ecr.<region>.amazonaws.com ; images pushed per dockerfiles/build.sh
        process {
            withLabel: gpu       { cpus = 8; memory = 128.GB }
            withLabel: cpu_large { cpus = 8; memory = 60.GB }
            withLabel: cpu_small { cpus = 2; memory = 16.GB }
        }
    }

    test {
        docker.enabled = false
        params.gw20_input        = "${projectDir}/assets/test/gw20_input.h5ad"
        params.gw34_raw          = "${projectDir}/assets/test/gw34_raw.h5ad"
        params.snrna_ref         = "${projectDir}/assets/test/snrna.h5ad"
        params.gw20_signaling    = "${projectDir}/assets/test/gw20_signaling.csv"
        params.gw34_h1_placeholder = "${projectDir}/assets/test/gw34_h1.parquet"
        // tiny resources so the stub DAG runs on any laptop
        process {
            withLabel: gpu       { cpus = 1; memory = 1.GB }
            withLabel: cpu_large { cpus = 1; memory = 1.GB }
            withLabel: cpu_small { cpus = 1; memory = 1.GB }
        }
    }
}
